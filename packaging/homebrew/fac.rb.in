class Fac < Formula
  desc "Fig-style autocomplete for the macOS terminal"
  homepage "https://github.com/@REPO@"
  license "MIT"

  depends_on :macos

  on_arm do
    url "https://github.com/@REPO@/releases/download/v@VERSION@/fac-@VERSION@-aarch64-apple-darwin.tar.gz"
    sha256 "@SHA256_ARM@"
  end

  on_intel do
    url "https://github.com/@REPO@/releases/download/v@VERSION@/fac-@VERSION@-x86_64-apple-darwin.tar.gz"
    sha256 "@SHA256_INTEL@"
  end

  def install
    bin.install "fac"
  end

  def caveats
    <<~EOS
      Run `fac init` to start fac in your terminals.
    EOS
  end

  test do
    assert_match "fac #{version}", shell_output("#{bin}/fac --version")
  end
end
